SPIDER_ENV=development

DATABASE_URL=postgres://spider:spider@localhost:5432/spider?sslmode=disable

REDIS_URL=redis://localhost:6379/0

SPIDER_API_HOST=0.0.0.0
SPIDER_API_PORT=8000

SPIDER_JWT_SECRET=change-me
SPIDER_JWT_ALGORITHM=HS256
SPIDER_JWT_EXPIRE_MINUTES=1440

SPIDER_WORKER_TOKEN=development-worker-token

SPIDER_CORS_ORIGINS=http://localhost:5173

# noop | rule-based | prompt-shield
SPIDER_DEFAULT_DETECTOR=prompt-shield

# Prompt-Shield models: https://huggingface.co/collections/robbypambudi/prompt-shield
SPIDER_PROMPT_SHIELD_ENDPOINT=http://localhost:8081
SPIDER_PROMPT_SHIELD_MODEL=robbypambudi/prompt-shield-flan-t5-small
# HF_TOKEN=hf_...  # optional, for gated models

# threshold
SPIDER_DEFAULT_SECURITY_POLICY=threshold

SPIDER_DEFAULT_THRESHOLD=0.5

# closed | open  (ERROR decision fail-closed vs fail-open)
SPIDER_FAIL_MODE=closed

SPIDER_LOG_PROMPT_CONTENT=false
SPIDER_PERSIST_PROMPT_CONTENT=false

SPIDER_WORKER_HEARTBEAT_INTERVAL=10
SPIDER_WORKER_OFFLINE_TIMEOUT=30

SPIDER_CHUNKER=fixed
SPIDER_CHUNK_SIZE=2048
SPIDER_CHUNK_OVERLAP=128

SPIDER_DEFAULT_MODEL=mock-llm
SPIDER_SERVING_PROVIDER=mock

SPIDER_BOOTSTRAP_ADMIN_EMAIL=admin@spider.local
SPIDER_BOOTSTRAP_ADMIN_PASSWORD=spider-admin

SPIDER_API_BASE_URL=http://localhost:8000

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
