FROM python:3.12-slim

WORKDIR /app

# torch CPU runtime dependency
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY backend/cmd/prompt-shield/pyproject.toml backend/cmd/prompt-shield/uv.lock* /app/
RUN uv sync --no-dev --no-install-project

COPY backend/cmd/prompt-shield /app
RUN uv sync --no-dev

ENV SPIDER_PROMPT_SHIELD_MODEL=robbypambudi/prompt-shield-flan-t5-small
EXPOSE 8081
CMD ["uv", "run", "python", "main.py"]
