# Build stage
FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY backend/go.mod backend/go.sum* ./
COPY backend/ .
RUN go mod tidy && \
    CGO_ENABLED=0 go build -o /out/spider-api ./cmd/api && \
    CGO_ENABLED=0 go build -o /out/spider-controller ./cmd/controller && \
    CGO_ENABLED=0 go build -o /out/spider-worker ./cmd/worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=builder /out/spider-api /app/spider-api
COPY --from=builder /out/spider-controller /app/spider-controller
COPY --from=builder /out/spider-worker /app/spider-worker
EXPOSE 8000
CMD ["/app/spider-api"]
